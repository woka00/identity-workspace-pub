COMPOSE_PROJECT_NAME=avatar-id
# Copy to .env on the VPS. Do not put secret values in this file.
PUBLIC_URL=https://avatar.example.com
PLAYER_TZ=Europe/Berlin
APP_PORT=8080
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
RUN_MIGRATIONS=false
# Set true only after configuring secrets/brevo_api_key and adding the registration overlay.
REGISTRATION_ENABLED=false
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=identity workspace
# Contact identifier placed into signed Web Push requests.
VAPID_SUBJECT=mailto:admin@example.com
# Usually leave empty for a same-origin deployment.
CORS_ORIGIN=
# Callback URLs may be omitted; backend derives the exact paths from PUBLIC_URL.
FATSECRET_CALLBACK_URL=https://avatar.example.com/api/integrations/fatsecret/callback
