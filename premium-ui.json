{
  "profile": "product-admin",
  "sourceRoots": ["frontend/src"],
  "locale": "ru-RU",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Date", "Form", "Scrollbar", "CRUD"],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "native"
  },
  "requiredCommands": ["frontend", "desktop"],
  "commands": {
    "frontend": "cd frontend && npm run build",
    "desktop": "cd desktop && npm run check"
  }
}
