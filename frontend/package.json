{
  "name": "identity-workspace-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "check:pwa": "node ./scripts/check-pwa.mjs",
    "check:nutrition": "node ./scripts/check-nutrition-goals.mjs",
    "check:theme": "node ./scripts/check-theme.mjs",
    "check": "npm run check:architecture && npm run check:pwa && npm run check:nutrition && npm run check:theme",
    "build": "npm run check && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "pdfmake": "0.2.20",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/pdfmake": "0.2.13",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "^6.4.3"
  }
}
