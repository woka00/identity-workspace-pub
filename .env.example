# Local Docker Compose development. Copy to .env.
APP_ENV=development
COMPOSE_PROJECT_NAME=avatar-id-local
APP_PORT=8080
POSTGRES_USER=avatar
POSTGRES_PASSWORD=avatar
POSTGRES_DB=avatarid
DATABASE_URL=postgres://avatar:avatar@db:5432/avatarid?sslmode=disable&connect_timeout=10
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
PLAYER_TZ=Europe/Moscow
ADDR=:8080
PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
TRUST_PROXY=false
RUN_MIGRATIONS=true

# Generate once with: openssl rand -base64 32
# Required for encrypted OAuth tokens and Web Push reminders. Never rotate it
# without a planned data migration because the VAPID key is derived from it.
DATA_ENCRYPTION_KEY=
# Public registration requires HTTPS, a data encryption key and a verified Brevo sender.
REGISTRATION_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=identity workspace
# Optional explicit 32-byte base64url VAPID private key. Usually leave empty.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# FatSecret Platform: existing accounts only, 3-legged OAuth 1.0.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_CALLBACK_URL=http://localhost:8080/api/integrations/fatsecret/callback
# Для Open Food Facts желательно указать реальный контактный email владельца.
OPENFOODFACTS_USER_AGENT=identity-workspace/1.0 (you@example.com)
# Russian food database when Premier localization is available.
FATSECRET_REGION=RU
FATSECRET_LANGUAGE=ru
