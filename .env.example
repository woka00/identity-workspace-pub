# Local development only. Copy this file to .env.
APP_ENV=development
COMPOSE_PROJECT_NAME=identity-workspace-local
APP_PORT=8080

# These are documented local-only database credentials. Do not reuse them.
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity-local-only
POSTGRES_DB=identity_workspace
DATABASE_URL=postgres://identity:identity-local-only@db:5432/identity_workspace?sslmode=disable&connect_timeout=10

PLAYER_TZ=Europe/Moscow
PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
TRUST_PROXY=false
RUN_MIGRATIONS=true

# Generate before connecting OAuth providers or enabling Web Push:
#   openssl rand -base64 32
# Keep the generated value stable for the lifetime of the local database.
DATA_ENCRYPTION_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Register your own OAuth applications before enabling either integration.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_CALLBACK_URL=http://localhost:8080/api/integrations/fatsecret/callback

TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_CALLBACK_URL=http://localhost:8080/api/integrations/ticktick/callback
